1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Tonearm now playing overlay for OBS Studio"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "tonearm"
      VALUE "LegalCopyright", "Tonearm contributors, GPL-2.0-or-later"
      VALUE "OriginalFilename", "tonearm.dll"
      VALUE "ProductName", "Tonearm"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
